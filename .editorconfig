# Editors that support EditorConfig (VS Code via extension, JetBrains built in)
# pick these up automatically. They match ruff (4 spaces, 120 columns) and the
# front-end code (2 spaces).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
