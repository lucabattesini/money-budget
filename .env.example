# Single env file for the whole project. Copy to .env at the repo root.
#   cp .env.example .env
# Used by docker compose, the FastAPI back-end and the Vite front-end.
# Only variables prefixed with VITE_ are exposed to the browser.

# --- Postgres (docker compose) ---
POSTGRES_USER=money
POSTGRES_PASSWORD=money
POSTGRES_DB=money_budget
# Port published on your machine. Change it if 5432 is taken (e.g. a local Postgres).
# POSTGRES_PORT=5432

# --- Back-end ---
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
# Secret that signs login tokens. Generate one with: openssl rand -hex 32
# The app refuses to start without it, unless APP_ENV=development (local dev only,
# which falls back to an insecure built-in key).
# JWT_SECRET=
APP_ENV=development
FRONT_URL=http://localhost:5173
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional. Defaults to a local SQLite file (back-end/test.db). For Postgres use
# the explicit psycopg2 driver (a bare postgresql:// resolves to psycopg v3 on
# SQLAlchemy 2.1). docker compose sets this automatically.
# DB_URL=postgresql+psycopg2://money:money@localhost:5432/money_budget

# --- Front-end ---
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
